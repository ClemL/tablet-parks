# Every variable is optional. With none set, each new game provisions its own
# Upstash Redis database through https://upstash.com/start-redis.

# Seals the links the tablet and phones hold (AES-256-GCM). Set any long random
# string on Vercel so a redeploy does not invalidate games that are in progress;
# without it, each build mints its own key.
TABLE_SECRET=

# Where games live: "start-redis" (default) provisions a fresh database per game,
# "env" uses the database below for every game, "memory" keeps games in process
# memory (local runs and tests only).
# PARKS_STORE=start-redis

# A shared database used when provisioning fails, or for every game with PARKS_STORE=env.
# The Vercel Upstash integration sets either pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Override the provisioning endpoint (only useful for local mocks and the browser tests).
# UPSTASH_START_REDIS_URL=https://upstash.com/start-redis

# Multiplies the per-address limits on new games (12 per 10 minutes) and joins (40).
# PARKS_RATE_LIMIT=1
